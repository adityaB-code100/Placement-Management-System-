# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_name>.mongodb.net/placement_db?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_secure_jwt_secret_key_here

# Backend Port
PORT=5000

# Allowed Frontend URL for CORS (e.g., Vercel production URL or localhost)
FRONTEND_URL=http://localhost:5173
